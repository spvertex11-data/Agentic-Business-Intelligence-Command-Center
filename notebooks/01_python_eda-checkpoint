    "# PYTHON STEP 22/22\n",
    "# Create Business Flags and Export Cleaned Dataset\n",
    "# Level: HARD\n",
    "\n",
    "df[\"Profit_Status\"] = np.where(\n",
    "    df[\"Profit\"] < 0,\n",
    "    \"Loss\",\n",
    "    \"Profit\"\n",
    ")\n",
    "\n",
    "df[\"High_Discount_Flag\"] = np.where(\n",
    "    df[\"Discount\"] >= df[\"Discount\"].median(),\n",
    "    \"High Discount\",\n",
    "    \"Normal Discount\"\n",
    ")\n",
    "\n",
    "df[\"High_Shipping_Cost_Flag\"] = np.where(\n",
    "    df[\"Shipping_Cost\"] >= df[\"Shipping_Cost\"].quantile(0.75),\n",
    "    \"High Shipping Cost\",\n",
    "    \"Normal Shipping Cost\"\n",
    ")\n",
    "\n",
    "df[[\n",
    "    \"Order_ID\",\n",
